            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and dragStart and startPos
            and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then moved = true end
            ZBtn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    ZBtn.MouseButton1Click:Connect(function()
        if moved then return end
        if State.UIOpen then
            State.UIOpen = false
            TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Size = UDim2.new(0, WIN_W, 0, 0)
            }):Play()
            task.delay(0.2, function()
                if not State.UIOpen then Main.Visible = false end
            end)
        else
            State.UIOpen = true
            Main.Visible = true
            Main.Size = UDim2.new(0, WIN_W, 0, 0)
            TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Size = UDim2.new(0, WIN_W, 0, WIN_H)
            }):Play()
        end
    end)
