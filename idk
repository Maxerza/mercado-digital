local function getChar(): (Model?, Humanoid?, BasePart?)
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    return char,
        char:FindFirstChildOfClass("Humanoid"),
        char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function onPress(btn: GuiButton, fn: () -> ())
    local last = 0
    local function guard()
        local t = tick()
        if t - last < 0.2 then return end
        last = t
        fn()
    end
    btn.MouseButton1Click:Connect(guard)
    btn.TouchTap:Connect(guard)
    btn.Activated:Connect(guard)
end

