-- ============================================
-- HELPERS
-- ============================================
local function clearConn(key: string)
    local c = Connections[key]
    if c then c:Disconnect(); Connections[key] = nil end
end

local function getChar(): (Model?, Humanoid?, BasePart?)
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    return char, hum, root
end

local function getRole(player: Player): string
    local char = player.Character
    if not char then return "Innocent" end

    local roleAttr = player:GetAttribute("Role") or char:GetAttribute("Role")
    if typeof(roleAttr) == "string" and roleAttr ~= "" then
        return roleAttr
    end

    local roleValue = player:FindFirstChild("Role")
        or player:FindFirstChild("role")
        or char:FindFirstChild("Role")
    if roleValue and roleValue:IsA("StringValue") then
        return roleValue.Value
    end

    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local tn = string.lower(tool.Name)
                if string.find(tn, "knife") or string.find(tn, "murder") then
                    return "Murderer"
                elseif string.find(tn, "gun") or string.find(tn, "sheriff") then
                    return "Sheriff"
                elseif string.find(tn, "hero") then
                    return "Hero"
                end
            end
        end
    end

    return "Innocent"
end

local function roleColor(role: string): Color3
    local rl = string.lower(role)
    if string.find(rl, "murder") then return Color3.fromRGB(255, 50, 50) end
    if string.find(rl, "sheriff") then return Color3.fromRGB(80, 140, 255) end
    if string.find(rl, "hero") then return Color3.fromRGB(255, 200, 60) end
    return Color3.fromRGB(120, 255, 130)
end

