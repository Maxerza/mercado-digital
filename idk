local function createSlider(
    parent: Instance,
    name: string,
    order: number,
    minV: number,
    maxV: number,
    default: number,
    onChange: (number) -> (),
    height: number?
): (Frame, (number) -> ())
    local h = height or 44

    local holder = Instance.new("Frame")
    holder.Name = string.gsub(name, "%s", "") .. "Slider"
    holder.Size = UDim2.new(1, 0, 0, h)
    holder.BackgroundColor3 = Color3.fromRGB(24, 22, 33)
    holder.BorderSizePixel = 0
    holder.LayoutOrder = order
    holder.Parent = parent

    local hc = Instance.new("UICorner")
    hc.CornerRadius = UDim.new(0, 8)
    hc.Parent = holder

    local hs = Instance.new("UIStroke")
    hs.Color = Color3.fromRGB(70, 55, 90)
    hs.Thickness = 1.2
    hs.Transparency = 0.45
    hs.Parent = holder

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -70, 0, 14)
    lbl.Position = UDim2.new(0, 12, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(230, 225, 245)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 50, 0, 14)
    valueLbl.Position = UDim2.new(1, -62, 0, 4)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = tostring(default)
    valueLbl.TextColor3 = Color3.fromRGB(255, 150, 210)
    valueLbl.TextSize = 12
    valueLbl.Font = Enum.Font.GothamBlack
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Parent = holder

    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -24, 0, 22)
    hit.Position = UDim2.new(0, 12, 0, h - 22)
    hit.BackgroundTransparency = 1
    hit.Parent = holder

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 8)
    track.Position = UDim2.new(0, 0, 0.5, -4)
    track.BackgroundColor3 = Color3.fromRGB(46, 40, 58)
    track.BorderSizePixel = 0
    track.Parent = hit

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 130, 200)
    fill.BorderSizePixel = 0
    fill.Parent = track

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track

    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob

    local ks = Instance.new("UIStroke")
    ks.Color = Color3.fromRGB(255, 130, 200)
    ks.Thickness = 2
    ks.Parent = knob

    local value = default

    local function setValue(v: number, silent: boolean?)
        value = math.clamp(math.floor(v + 0.5), minV, maxV)
        local rel = (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLbl.Text = tostring(value)
        if not silent then onChange(value) end
    end

    local dragging = false

    local function fromX(x: number)
        local rel = math.clamp((x - hit.AbsolutePosition.X) / hit.AbsoluteSize.X, 0, 1)
        setValue(minV + rel * (maxV - minV))
    end

    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromX(i.Position.X)
        end
    end)

    hit.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
            fromX(i.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    setValue(default, true)

    return holder, setValue
end

