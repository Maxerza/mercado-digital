    local btn = Instance.new("TextButton")
    btn.Name = string.gsub(name, "%s", "") .. "Btn"
    btn.Size = UDim2.new(0, width or 138, 0, h)
    btn.BackgroundColor3 = Color3.fromRGB(26, 24, 36)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(70, 55, 90)
    stroke.Thickness = 1.2
    stroke.Transparency = 0.4
    stroke.Parent = btn

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 0.6, 0)
    accent.Position = UDim2.new(0, 0, 0.2, 0)
    accent.BackgroundColor3 = Color3.fromRGB(100, 80, 120)
    accent.BorderSizePixel = 0
    accent.Parent = btn

    local accCorner = Instance.new("UICorner")
    accCorner.CornerRadius = UDim.new(1, 0)
    accCorner.Parent = accent

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 8, 0, 8)
    dot.Position = UDim2.new(0, 12, 0.5, -4)
    dot.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
    dot.BorderSizePixel = 0
    dot.Parent = btn

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = dot

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -84, 1, 0)
    lbl.Position = UDim2.new(0, 26, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(235, 235, 250)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(0, 46, 0, 18)
    status.Position = UDim2.new(1, -54, 0.5, -9)
    status.BackgroundColor3 = Color3.fromRGB(40, 36, 52)
    status.BorderSizePixel = 0
    status.Text = "OFF"
    status.TextColor3 = Color3.fromRGB(150, 145, 170)
    status.TextSize = 10
    status.Font = Enum.Font.GothamBlack
    status.Parent = btn

    local statusCorner = Instance.new("UICorner")
    statusCorner.CornerRadius = UDim.new(0, 5)
    statusCorner.Parent = status

    local on = false

    local function setState(v: boolean, silent: boolean?)
        on = v
        if not silent then callback(v) end
        if on then
            dot.BackgroundColor3 = Color3.fromRGB(0, 220, 140)
            stroke.Color = Color3.fromRGB(0, 200, 130)
            stroke.Transparency = 0.2
            accent.BackgroundColor3 = Color3.fromRGB(0, 200, 130)
            status.Text = "ON"
            status.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
            status.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            dot.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
            stroke.Color = Color3.fromRGB(70, 55, 90)
            stroke.Transparency = 0.4
            accent.BackgroundColor3 = Color3.fromRGB(100, 80, 120)
            status.Text = "OFF"
            status.BackgroundColor3 = Color3.fromRGB(40, 36, 52)
            status.TextColor3 = Color3.fromRGB(150, 145, 170)
        end
    end

    onPress(btn, function() setState(not on) end)

    return btn, setState
end

