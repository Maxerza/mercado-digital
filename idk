local function createFeatureButton(
    parent: Instance, name: string, order: number,
    callback: (boolean) -> (),
    width: number?
)
    local btn = Instance.new("TextButton")
    btn.Name = string.gsub(name, "%s", "") .. "Btn"
    btn.Size = UDim2.new(0, width or 188, 0, 54)
    btn.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 50, 80)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.4
    stroke.Parent = btn

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 0.6, 0)
    accent.Position = UDim2.new(0, 0, 0.2, 0)
    accent.BackgroundColor3 = Color3.fromRGB(90, 70, 110)
    accent.BorderSizePixel = 0
    accent.Parent = btn

    local accCorner = Instance.new("UICorner")
    accCorner.CornerRadius = UDim.new(1, 0)
    accCorner.Parent = accent

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.Position = UDim2.new(0, 16, 0, 13)
    dot.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
    dot.BorderSizePixel = 0
    dot.Parent = btn

    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = dot

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -32, 0, 18)
    lbl.Position = UDim2.new(0, 32, 0, 9)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(235, 235, 250)
    lbl.TextSize = 14
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -32, 0, 14)
    status.Position = UDim2.new(0, 32, 0, 29)
    status.BackgroundTransparency = 1
    status.Text = "OFF • tap to enable"
    status.TextColor3 = Color3.fromRGB(150, 150, 170)
    status.TextSize = 10
    status.Font = Enum.Font.Gotham
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = btn

    local isOn = false

    local function updateVisual(on: boolean)
        isOn = on
        if on then
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(45, 20, 45)
            }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {
                Color = Color3.fromRGB(220, 80, 130), Transparency = 0
            }):Play()
            TweenService:Create(accent, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(255, 100, 150)
            }):Play()
            TweenService:Create(dot, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(120, 255, 140)
            }):Play()
            status.Text = "ON • tap to disable"
            status.TextColor3 = Color3.fromRGB(120, 255, 140)
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(24, 24, 34)
            }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {
                Color = Color3.fromRGB(60, 50, 80), Transparency = 0.4
            }):Play()
            TweenService:Create(accent, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(90, 70, 110)
            }):Play()
            TweenService:Create(dot, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(90, 90, 110)
            }):Play()
            status.Text = "OFF • tap to enable"
            status.TextColor3 = Color3.fromRGB(150, 150, 170)
        end
    end

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = isOn and Color3.fromRGB(58, 26, 58) or Color3.fromRGB(32, 32, 44)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = isOn and Color3.fromRGB(45, 20, 45) or Color3.fromRGB(24, 24, 34)
        }):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        updateVisual(not isOn)
        callback(isOn)
    end)

    return btn
end

