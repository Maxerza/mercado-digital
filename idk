-- FEATURE BUTTON FACTORY
-- ============================================
local function createFeatureButton(
    parent: Instance, name: string, order: number,
    callback: (boolean) -> (),
    width: number?
)
    local btn = Instance.new("TextButton")
    btn.Name = string.gsub(name, "%s", "") .. "Btn"
    btn.Size = UDim2.new(0, width or 188, 0, 54)
    btn.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 50, 80)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.4
    stroke.Parent = btn

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 18)
    lbl.Position = UDim2.new(0, 12, 0, 9)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(235, 235, 250)
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -20, 0, 14)
    status.Position = UDim2.new(0, 12, 0, 29)
    status.BackgroundTransparency = 1
    status.Text = "OFF"
    status.TextColor3 = Color3.fromRGB(150, 150, 170)
    status.TextSize = 10
    status.Font = Enum.Font.Gotham
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = btn

    local isOn = false

    local function updateVisual(on: boolean)
        isOn = on
        if on then
            TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(45, 20, 45) }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(220, 80, 130), Transparency = 0 }):Play()
            status.Text = "ON"
            status.TextColor3 = Color3.fromRGB(120, 255, 140)
        else
            TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(24, 24, 34) }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(60, 50, 80), Transparency = 0.4 }):Play()
            status.Text = "OFF"
            status.TextColor3 = Color3.fromRGB(150, 150, 170)
        end
    end

    btn.MouseButton1Click:Connect(function()
        updateVisual(not isOn)
        callback(isOn)
    end)

    return btn
end

