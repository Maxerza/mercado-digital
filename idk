-- ESP SYSTEM
-- ============================================
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ZHub_ESP"
ESPFolder.Parent = Workspace

local ESPTracker: { [Instance]: any } = {}
local ESPCats = { "Players", "Twisteds", "Items", "Machines", "Doors" }

local ESPCol = {
    Players     = Color3.fromRGB(70, 150, 255),    -- blue  (unchanged)
    Twisteds    = Color3.fromRGB(255, 60, 60),     -- red   (unchanged)
    Items       = Color3.fromRGB(255, 150, 50),    -- orange
    MachineIdle = Color3.fromRGB(255, 255, 255),   -- white = unfinished
    MachineDone = Color3.fromRGB(70, 150, 255),    -- blue  = finished
    Doors       = Color3.fromRGB(190, 130, 255),   -- violet
}

local ESPCfg = {
    ScanActors  = 0.30,
    ScanParts   = 1.50,
    MaxDistance = 700,
    FillAlpha   = 0.65,
    HeadOffset  = 3.4,
    BaseWidth   = 190,
    BaseHeight  = 40,
    ItemPatterns    = { "capsule", "research", "tape" },
    MachinePatterns = { "machine", "generator", "extractor" },
    DoorPatterns    = { "door" },
    FolderHints     = { "twisted", "twisteds", "entity", "entities",
                        "npc", "npcs", "monster", "enemy", "enemies", "mob" },
}

local function espGet(cat: string, variant: string): boolean
    return (State :: any)[cat .. "ESP_" .. variant] == true
end

local function matchesAny(name: string, patterns: { string }): boolean
    local ln = string.lower(name)
    for _, p in ipairs(patterns) do
        if string.find(ln, p, 1, true) then return true end
    end
    return false
end

local function textScale(): number
    return State.TextSize / 50
end

local function getPos(inst: Instance): Vector3?
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then
        local okp, cf = pcall(function() return inst:GetPivot() end)
        if okp and cf then return cf.Position end
        local pp = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
        if pp then return pp.Position end
    end
    return nil
end

local DONE_KEYS = { "progress", "completion", "complete", "completed", "done",
                    "finished", "percent", "repaired", "fixed", "filled" }

local function numDone(v: any): boolean
    if type(v) == "boolean" then return v end
    if type(v) == "number" then
        if v >= 100 then return true end
        if v >= 0.99 and v <= 1.01 then return true end
        if v == math.floor(v) and v >= 1 and v <= 2 then return true end
    end
    return false
end

local function isMachineDone(inst: Instance): boolean
    for _, key in ipairs(DONE_KEYS) do
        local okA, v = pcall(function() return inst:GetAttribute(key) end)
        if okA and v ~= nil and numDone(v) then return true end
    end
    for _, c in ipairs(inst:GetDescendants()) do
        if (c:IsA("BoolValue") or c:IsA("NumberValue") or c:IsA("IntValue"))
            and matchesAny(c.Name, DONE_KEYS) and numDone((c :: any).Value) then
            return true
        end
    end
    return false
end

local function colorFor(cat: string, inst: Instance): Color3
    if cat == "Machines" then
        return isMachineDone(inst) and ESPCol.MachineDone or ESPCol.MachineIdle
    end
    return (ESPCol :: any)[cat]
end

local function espCleanup(seen: { [Instance]: boolean }, cats: { [string]: boolean })
    for inst, rec in pairs(ESPTracker) do
        if cats[rec.cat] and (not seen[inst] or not inst.Parent) then
            if rec.hl then rec.hl:Destroy() end
            if rec.bb then rec.bb:Destroy() end
            ESPTracker[inst] = nil
        end
    end
end

local function espEnsure(inst: Instance, cat: string, name: string)
    local wantHL = espGet(cat, "NoText")
    local wantBB = espGet(cat, "Text") and State.TextSize > 0

    if not wantHL and not wantBB then
        local old = ESPTracker[inst]
        if old then
            if old.hl then old.hl:Destroy() end
            if old.bb then old.bb:Destroy() end
            ESPTracker[inst] = nil
        end
        return
    end

    local rec = ESPTracker[inst]
    if not rec then
        rec = { cat = cat }
        ESPTracker[inst] = rec
    end
    rec.cat = cat
    rec.name = name

    local col = colorFor(cat, inst)

    -- HIGHLIGHT (no text)
    if wantHL then
        if not rec.hl then
            local h = Instance.new("Highlight")
            h.Name = "ZHub_HL"
            h.Adornee = inst
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.FillTransparency = ESPCfg.FillAlpha
            h.OutlineTransparency = 0.15
            h.Parent = ESPFolder
            rec.hl = h
            table.insert(ESPObjects, h)
        end
        rec.hl.FillColor = col
        rec.hl.OutlineColor = col
    elseif rec.hl then
        rec.hl:Destroy()
        rec.hl = nil
    end

    -- BILLBOARD (with text)
    if wantBB then
        if not rec.bb then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ZHub_Tag"
            bb.Adornee = inst
            bb.AlwaysOnTop = true
            bb.LightInfluence = 0
            bb.MaxDistance = ESPCfg.MaxDistance
            bb.Parent = ESPFolder

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Size = UDim2.fromScale(1, 1)
            lbl.Font = Enum.Font.GothamBold
            lbl.TextScaled = true
            lbl.TextStrokeTransparency = 0.35
            lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
            lbl.Parent = bb

            rec.bb = bb
            rec.lbl = lbl
        end

        local s = textScale()
        rec.bb.Size = UDim2.fromOffset(ESPCfg.BaseWidth * s, ESPCfg.BaseHeight * s)

        if rec.lbl then
            rec.lbl.TextColor3 = col
            local p = getPos(inst)
            local cam = Workspace.CurrentCamera
            local d = 0
            if p and cam then d = (cam.CFrame.Position - p).Magnitude end
            local tag = ""
            if cat == "Machines" then
                tag = isMachineDone(inst) and "  [DONE]" or "  [..]"
            end
            rec.lbl.Text = name .. tag .. "  [" .. math.floor(d) .. "m]"
        end
    elseif rec.bb then
        rec.bb:Destroy()
        rec.bb = nil
        rec.lbl = nil
    end
end

local function applyTextScale()
    local s = textScale()
    for _, rec in pairs(ESPTracker) do
        if rec.bb then
            rec.bb.Size = UDim2.fromOffset(ESPCfg.BaseWidth * s, ESPCfg.BaseHeight * s)
        end
    end
end

-- --- Twisted detection (deep folder scan, no humanoid required if in entity folder) ---
local function isUnderEntityFolder(inst: Instance): boolean
    local anc: Instance? = inst.Parent
    while anc and anc ~= Workspace do
        if matchesAny(anc.Name, ESPCfg.FolderHints) then return true end
        anc = anc.Parent
    end
    return false
end

local function isTwistedModel(m: Model): boolean
    if m == LocalPlayer.Character then return false end

    local underEntity = isUnderEntityFolder(m)
    if Players:GetPlayerFromCharacter(m) and not underEntity then return false end

    if m:FindFirstChildOfClass("Humanoid") then return true end

    if underEntity then
        return (m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")) ~= nil
    end
    return false
end

local function scanActors()
    local seen: { [Instance]: boolean } = {}
    local cam = Workspace.CurrentCamera

    -- players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local m = plr.Character
            local hum = m:FindFirstChildOfClass("Humanoid")
            local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
            if hum and root and hum.Health > 0 then
                local dist = cam and (cam.CFrame.Position - root.Position).Magnitude or 0
                if dist <= ESPCfg.MaxDistance then
                    seen[m] = true
                    espEnsure(m, "Players", plr.Name)
                end
            end
        end
    end

    -- twisteds: walk folders at any depth, and step into non-humanoid models
    local function visit(container: Instance, depth: number)
        if depth > 5 then return end
        for _, obj in ipairs(container:GetChildren()) do
            if obj ~= ESPFolder then
                if obj:IsA("Folder") then
                    visit(obj, depth + 1)
                elseif obj:IsA("Model") then
                    if isTwistedModel(obj) then
                        seen[obj] = true
                        espEnsure(obj, "Twisteds", obj.Name)
                    elseif not obj:FindFirstChildOfClass("Humanoid") then
                        visit(obj, depth + 1)
                    end
                end
            end
        end
    end
    visit(Workspace, 0)

    espCleanup(seen, { Players = true, Twisteds = true })
end

local function scanParts()
    local seen: { [Instance]: boolean } = {}
    local cam = Workspace.CurrentCamera

    for _, d in ipairs(Workspace:GetDescendants()) do
        local isModel = d:IsA("Model")
        local isPart  = d:IsA("BasePart")

        if isModel or isPart then
            local cat: string? = nil
            if matchesAny(d.Name, ESPCfg.ItemPatterns) then
                cat = "Items"
            elseif matchesAny(d.Name, ESPCfg.MachinePatterns) then
                cat = "Machines"
            elseif matchesAny(d.Name, ESPCfg.DoorPatterns) then
                cat = "Doors"
            end

            if cat then
                local skip = false
                if isPart then
                    local anc: Instance? = d.Parent
                    while anc and anc ~= Workspace do
                        if anc:IsA("Model") and (matchesAny(anc.Name, ESPCfg.ItemPatterns)
                            or matchesAny(anc.Name, ESPCfg.MachinePatterns)
                            or matchesAny(anc.Name, ESPCfg.DoorPatterns)) then
                            skip = true
                            break
                        end
                        anc = anc.Parent
                    end
                end

                if not skip then
                    local p = getPos(d)
                    if p and cam and (cam.CFrame.Position - p).Magnitude <= ESPCfg.MaxDistance then
                        seen[d] = true
                        espEnsure(d, cat, d.Name)
                    end
                end
            end
        end
    end

    espCleanup(seen, { Items = true, Machines = true, Doors = true })
end

local function espRefresh()
    task.spawn(scanActors)
    task.spawn(scanParts)
end

task.spawn(function()
    while ScreenGui.Parent do
        pcall(scanActors)
        task.wait(ESPCfg.ScanActors)
    end
end)

task.spawn(function()
